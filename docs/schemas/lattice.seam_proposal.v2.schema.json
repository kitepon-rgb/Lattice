{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kitepon/Lattice/blob/main/docs/schemas/lattice.seam_proposal.v2.schema.json",
  "title": "lattice.seam_proposal.v2",
  "description": "Typed decisions for complete todo-independence conflict components, including accepted structural seam proposals and explicit serial or unknown outcomes.",
  "$comment": "query_set_digest binds the exact sensor query set input used to collect evidence, with the same meaning as digestArtifact(request.sensor_query_set) in the runtime front end; this artifact does not embed that input, so validateSeamProposal checks only its digest shape. Runtime validation additionally enforces byte-based text limits, strict lexical ordering and key uniqueness, component connectivity, task-pair and owner_task_ids cross-references, complete proposed ownership of component tasks, stable-role versus task-owned proposed-surface ownership, path target equality, code-seam-only accepted conflict kinds, empty accepted unknowns and residual conflicts, the evidence_digest self-digest over the evidence record, deterministic proposal_id derivation, and proposal_digest/result_digest self-digests. JSON Schema uniqueItems covers duplicate full entries only; ordering, key uniqueness, cross-reference, semantic-ID and self-digest rules are enforced by validateSeamProposal. v2 adds candidate_paths to each sensor receipt: a name that resolves to several files is recorded with its candidates instead of collapsing to unknown, so a declared concern anchor can be narrowed by the resource it was declared within (ADR 0134). Candidates are present only when outcome is ambiguous, and an ambiguous receipt never also carries a singular resolved_path. Records written under lattice.seam_proposal.v1 are not migrated; the artifact is a host-local record regenerable from the independence record and the sensor, so a stale record is rejected with recompile_seam_proposal_or_remove_stale_record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "plan_key",
    "source_binding",
    "compiled_at",
    "decisions",
    "result_digest"
  ],
  "properties": {
    "schema": {
      "const": "lattice.seam_proposal.v2"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "plan_key": {
      "$ref": "#/$defs/identifier"
    },
    "source_binding": {
      "$ref": "#/$defs/sourceBinding"
    },
    "compiled_at": {
      "$ref": "#/$defs/strictTimestamp"
    },
    "decisions": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "result_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z._-]{0,127})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "strictTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "repoRelativePathOrPrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Normalized repo-relative path or path prefix. A trailing slash is permitted for a prefix.",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f\\\\]+/?$"
    },
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Normalized repo-relative non-prefix path.",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f\\\\/](?:[^\\u0000-\\u001f\\u007f\\\\]*[^\\u0000-\\u001f\\u007f\\\\/])?$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independence_schema",
        "independence_result_digest",
        "witness_set_digest",
        "plan_version",
        "topology_digest",
        "base_sha"
      ],
      "properties": {
        "independence_schema": {
          "const": "lattice.todo_independence.v3"
        },
        "independence_result_digest": {
          "$ref": "#/$defs/digest"
        },
        "witness_set_digest": {
          "$ref": "#/$defs/digest"
        },
        "plan_version": {
          "$ref": "#/$defs/identifier"
        },
        "topology_digest": {
          "$ref": "#/$defs/digest"
        },
        "base_sha": {
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "taskPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "kind",
        "target",
        "task_pairs"
      ],
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/boundedText"
        },
        "kind": {
          "enum": [
            "symbol",
            "path",
            "state",
            "effect"
          ]
        },
        "target": {
          "$ref": "#/$defs/boundedText"
        },
        "task_pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskPair"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "path"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/repoRelativePathOrPrefix"
              }
            }
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "path",
        "role",
        "owner_task_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "symbol",
            "path"
          ]
        },
        "target": {
          "$ref": "#/$defs/boundedText"
        },
        "path": {
          "$ref": "#/$defs/repoRelativePathOrPrefix"
        },
        "role": {
          "$ref": "#/$defs/identifier",
          "description": "facade, fixed_oracle and composition_test are stable roles; every other role is task-owned."
        },
        "owner_task_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "symbol"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "$ref": "#/$defs/repoRelativePath"
              }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "virtual_compile_input_digest",
        "virtual_compile_result_digest",
        "residual_conflicts"
      ],
      "properties": {
        "virtual_compile_input_digest": {
          "$ref": "#/$defs/digest"
        },
        "virtual_compile_result_digest": {
          "$ref": "#/$defs/digest"
        },
        "residual_conflicts": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "operation",
        "target",
        "outcome",
        "resolved_name",
        "resolved_path",
        "candidate_paths",
        "result_digest"
      ],
      "properties": {
        "query_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/boundedText"
        },
        "outcome": {
          "$ref": "#/$defs/identifier"
        },
        "resolved_name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/boundedText"
            }
          ]
        },
        "resolved_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/repoRelativePath"
            }
          ]
        },
        "candidate_paths": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "description": "Repo-relative paths the exact name resolved to when it lives in more than one file. Strictly sorted. Non-empty (at least two entries) exactly when outcome is ambiguous, and empty otherwise; an ambiguous receipt carries no singular resolved_path. Consumed only when binding a declared concern anchor to the resource it was declared within — it never widens the candidate set the sensor reported.",
          "items": {
            "$ref": "#/$defs/repoRelativePath"
          }
        },
        "result_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_set_digest",
        "evidence_digest",
        "queries"
      ],
      "properties": {
        "query_set_digest": {
          "$ref": "#/$defs/digest",
          "description": "External binding to the canonical sensor query set input used for collection; producers compute the digest from that input, while this standalone validator checks only the digest shape."
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest",
          "description": "Self-digest of this evidence object with evidence_digest omitted."
        },
        "queries": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/query"
          }
        }
      }
    },
    "seamCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "current_surfaces",
        "proposed_surfaces",
        "affected_tests",
        "verification",
        "evidence",
        "limits",
        "proposal_digest"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^seam-[0-9a-f]{64}$"
        },
        "current_surfaces": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "proposed_surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/surface"
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "enum": [
                        "facade",
                        "fixed_oracle",
                        "composition_test"
                      ]
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "then": {
                  "properties": {
                    "owner_task_ids": {
                      "maxItems": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "owner_task_ids": {
                      "minItems": 1,
                      "maxItems": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "affected_tests": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoRelativePath"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "contains": {
            "const": "structural_only"
          },
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "proposal_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "detail": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "task_ids",
        "conflicts",
        "verdict",
        "seam_candidate",
        "reasons",
        "unknowns"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/identifier"
        },
        "task_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/conflict"
          }
        },
        "verdict": {
          "enum": [
            "seam_candidate",
            "intentional_serial",
            "unknown_requires_evidence"
          ]
        },
        "seam_candidate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/seamCandidate"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/unknown"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "seam_candidate"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "seam_candidate": {
                "$ref": "#/$defs/seamCandidate"
              },
              "unknowns": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "seam_candidate": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "intentional_serial"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "unknown_requires_evidence"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "unknowns": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
