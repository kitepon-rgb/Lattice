+export function selectDispatchChannel(priority) {
+  if (priority !== 'urgent' && priority !== 'routine') {
+    throw new TypeError('priority must be urgent or routine');
+  }
+
+  return priority === 'urgent' ? 'pager' : 'queue';
+}
